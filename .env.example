# Local Control Plane
# Required for mutating control-plane APIs.
BOB_CONTROL_PLANE_TOKEN=replace-with-a-long-random-secret

# Persistent local state
# BOB_STORAGE_DIR=.bob-data

# Sandbox runtime: mock (default) or oci
BOB_SANDBOX_RUNTIME=mock

# OCI/Docker image used by the real sandbox adapter
# BOB_OCI_IMAGE=alpine:3.20

# Optional one-time Creator bootstrap secret.
# Keep unset until a dedicated bootstrap flow is implemented.
# BOB_CREATOR_BOOTSTRAP_TOKEN=
