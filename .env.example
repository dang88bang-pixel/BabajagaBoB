# BabajagaBoB – Umgebungsvariablen (Beispiel)
#
# Diese Datei ist eine Vorlage. Sie enthält keine echten Geheimnisse und darf
# niemals mit echten Secrets committet werden.

# ---------------------------------------------------------------------------
# Persistenter Zustand
# ---------------------------------------------------------------------------
# Wurzel aller Stores, Sandboxes, Snapshots und Evidenz.
# Standard: ./.bob-data  (wird nicht versioniert)
# BOB_STORAGE_DIR=.bob-data

# ---------------------------------------------------------------------------
# Creator-Zugang (Server-Authentifizierung, niemals im Browser)
# ---------------------------------------------------------------------------
# Einmal-Secret für den Bootstrap des Creators. Nach erfolgreichem Bootstrap
# wird es verworfen (Single-Use); danach ist ausschließlich der Creator-Login
# gültig. Mindestens 16 Zeichen.
# BOB_BOOTSTRAP_SECRET=

# Creator-Login-Secret (mindestens 16 Zeichen). Alternative: Datei
# <BOB_STORAGE_DIR>/creator-token (0600). Es wird nur der Hash gespeichert.
#   npm run creator:secret -- --rotate   (siehe docs/BOOTSTRAP.md)
# BOB_CREATOR_LOGIN_SECRET=

# HMAC-Schlüssel der Session-Schicht (Pflicht in Produktion, mindestens
# 32 Zeichen). Ohne ihn scheitert jede Session-Erstellung fail closed
# (HTTP 500 bei Bootstrap/Login). Rotation invalidiert bestehende Sessions
# bewusst — siehe docs/OPERATIONS.md („Session-Schlüssel").
# BOB_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Sandbox-Laufzeit
# ---------------------------------------------------------------------------
# mock  = deterministische Simulation (Standard, MOCK/SIMULATED)
# local = echte Prozessausführung mit argv[], shell:false (VERIFIED in CI)
# oci   = Docker/OCI-Adapter (gehärtet, in dieser Umgebung UNVERIFIED)
BOB_SANDBOX_RUNTIME=local

# OCI-Image für den echten Sandbox-Adapter (nur bei BOB_SANDBOX_RUNTIME=oci)
# BOB_OCI_IMAGE=alpine:3.20

# ---------------------------------------------------------------------------
# Legacy-Administrationstoken (standardmäßig AUS)
# ---------------------------------------------------------------------------
# Der Legacy-Token ist fail closed: er wirkt nur, wenn beide Variablen gesetzt
# sind, und ist ausschließlich für lokale Administration/CI gedacht. Browser
# erhalten ihn niemals.
# BOB_CONTROL_PLANE_TOKEN=
# BOB_ALLOW_LEGACY_CONTROL_TOKEN=1

# ---------------------------------------------------------------------------
# Betrieb / Deployment
# ---------------------------------------------------------------------------
# Port und Bindeadresse des Produktionsservers (`node server.mjs`).
# PORT=3000
# BOB_HOSTNAME=0.0.0.0

# Zeitfenster der Drainage bei SIGTERM/SIGINT (ms, mindestens 1000).
# Laufende Anfragen dürfen zu Ende laufen; danach Exit-Code 1 (erzwungen).
# BOB_SHUTDOWN_TIMEOUT_MS=15000

# Hinter einem Reverse Proxy (nginx/Caddy/Traefik, Container, Preview-Domäne)
# sind `Host`/`Origin` aus Sicht des Dienstes nicht der öffentliche Host. Erst
# mit dieser Freigabe werden `X-Forwarded-Host`/`X-Forwarded-Proto` ausgewertet.
# Ohne sie bleibt der Dienst fail closed und lehnt cookie-authentifizierte
# Mutationen mit 403 CSRF_ORIGIN ab, sobald Origin und interner Host abweichen.
# BOB_TRUST_PROXY=1

# SameSite-Attribut des Session-Cookies: strict (Standard) | lax | none.
# `none` ist nur für eingebettete Ansichten unter fremdem Ursprung gedacht und
# erzwingt `Secure`. Unbekannte Werte fallen fail closed auf `strict` zurück.
# BOB_COOKIE_SAMESITE=strict
# BOB_COOKIE_SECURE=1

# Ort des Namespace-Rootfs (Kernel-Isolation). Bau:
#   bash scripts/build-ns-rootfs.sh [ziel]
# BOB_NS_ROOTFS=.bob-data/ns-rootfs

# Delegierter cgroup-v2-Unterbaum für Speicher-/Prozesslimits. Einrichtung:
#   sudo BOB_CGROUP_DIR=/sys/fs/cgroup/bob bash scripts/setup-cgroup-delegation.sh
# Danach den Server innerhalb des Baums starten: scripts/cgroup-exec.sh
# BOB_CGROUP_DIR=/sys/fs/cgroup/bob

# OCI-Lifecycle-Test: mit `1` ist ein erreichbarer Docker-Daemon Pflicht
# (CI/Host mit Docker). Ohne den Schalter belegt der Test nur das
# Fail-closed-Verhalten und der Lifecycle bleibt NOT_VERIFIED.
# BOB_OCI_REQUIRED=0

# ---------------------------------------------------------------------------
# Geräte-Enrollment (Discovery-Agent)
# ---------------------------------------------------------------------------
# Geheimnis, mit dem sich Enrollment-Agents (scripts/discover-host.mjs) melden
# dürfen (mindestens 16 Zeichen). Es erlaubt ausschließlich Discovery und
# Lebenszeichen — niemals Autorisierung, Reservierung oder Freigabe (das bleibt
# ein Creator-Akt). Nicht gesetzt: Enrollment antwortet fail closed mit
# 503 ENROLLMENT_DISABLED.
# BOB_DEVICE_ENROLLMENT_SECRET=
